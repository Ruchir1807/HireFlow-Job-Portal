generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  USER
  ADMIN
}

enum ApplicationStatus{
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}


model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  company     String
  location    String
  salary      Int?
  createdAt   DateTime @default(now())
  applications Application[]
}

model User{
  id   Int    @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
  applications Application[]
}


model Application {
  id          Int               @id @default(autoincrement())
  userId      Int
  jobId       Int
  name        String
  skills      String
  address     String
  resumeUrl   String?
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}